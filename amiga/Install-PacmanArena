; $VER: Install-PacmanArena 0.1-gfos1 (17.11.2026)
; The Amiga Installer script for Pacman Arena, an AmiCradle game port.
; Made by amicradle scripts/ports/port_installer.py: change the spec, not this file.
; Run it from its icon, beside the PacmanArena drawer where the archive was unpacked.

(set @app-name "Pacman Arena")
(set #version "0.1-gfos1")
(set #drawer "PacmanArena")
(set #program "PacmanArena")
(set #space 29297)  ; KB

(onerror
    (message (cat "Pacman Arena was not installed completely." "\n\n" @error-msg
                  "\n\nFiles already copied stay where they are. Run Install-PacmanArena again to finish.")))

; the Installer, the CPU and the FPU
(if (< @installer-version 2818051)
    (abort "Pacman Arena needs Installer 43.3 or newer. This one is older: install AmigaOS 3.2 or a newer Installer."))
(set #cpu (database "cpu"))
(if (not (or (= #cpu "68040") (= #cpu "68060") (= #cpu "68080")))
    (abort (cat "Pacman Arena needs a 68040, 68060 or 68080 with an FPU. This Amiga has a " #cpu ".")))
(if (= (database "fpu") "NOFPU")
    (abort "Pacman Arena needs a 68040, 68060 or 68080 with an FPU. This Amiga has no FPU."))

; the package: the drawer beside this script
(set #source (pathonly (expandpath @icon)))
(set #from (tackon #source #drawer))
(if (<> (exists #from (noreq)) 2)
    (abort "The PacmanArena drawer is not beside Install-PacmanArena. Unpack the whole archive, then run Install-PacmanArena from there."))
(if (<> (exists (tackon #from #program) (noreq)) 1)
    (abort "The PacmanArena drawer has no PacmanArena in it. Unpack the whole archive again."))

(welcome "This installs Pacman Arena 0.1-gfos1 for AmigaOS 3.2 on a 68040, 68060 or 68080 with an FPU.")

; where: the parent drawer
(set #default
    (if (= (exists "Work:Games" (noreq)) 2) "Work:Games"
        (if (= (exists "Work:" (noreq)) 2) "Work:" "SYS:")))
(set #parent
    (askdir
        (prompt "Where should the PacmanArena drawer go? Choose the drawer to put it in.")
        (help "The Installer makes or updates a drawer called PacmanArena in the drawer you choose. An update keeps your saves and settings.")
        (default #default)))
(set #dest (tackon #parent #drawer))
(set #update (= (exists #dest (noreq)) 2))
; in KB where the Installer can say so: in bytes, 2 GB free and more does not fit
(set #free (if (>= @installer-version 2883584) (getdiskspace #parent "K")
    (/ (getdiskspace #parent) 1024)))
(if (and (>= #free 0) (< #free #space))
    (abort (cat "There is not enough room in " #parent ": Pacman Arena needs 30 MB free.")))

; the drawer: everything in it, but what the player has made
(set #kept "")
(if (not #update)
    (makedir #dest))
(if (= #kept "")
    (copyfiles
        (prompt "Copying Pacman Arena")
        (help @copyfiles-help)
        (source #from)
        (dest #dest)
        (all)
        (optional "force" "askuser"))
    (copyfiles
        (prompt (cat "Updating Pacman Arena. Kept as they are: " #kept))
        (help @copyfiles-help)
        (source #from)
        (dest #dest)
        (pattern (cat "~(" #kept ")"))
        (optional "force" "askuser")))
(if (<> (exists (tackon #parent "PacmanArena.info") (noreq)) 1)
    (copyfiles
        (help @copyfiles-help)
        (source #source)
        (dest #parent)
        (choices "PacmanArena.info")))

(set #later "")
(set @default-dest #dest)
(complete 100)
(if @pretend
    (message (cat "Pretend: nothing was copied or changed. Pacman Arena would have gone in " #dest "."))
    (message (cat "Pacman Arena 0.1-gfos1 is installed in " #dest "."
                  "\n\nTo start it, open the PacmanArena drawer and double-click the PacmanArena icon."
                  (if (= #kept "") "" (cat "\n\nLeft as they were: " #kept "."))
                  (if (= #later "") "" (cat "\n\nStill to add to the drawer: " #later ". Run Install-PacmanArena again to fetch or copy it.")))))
(exit (quiet))
